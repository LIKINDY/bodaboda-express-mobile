# Server Port
PORT=3000

# Environment: development / production
NODE_ENV=development

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_for_bodaboda_express_change_in_production
JWT_EXPIRES_IN=30d

# Database Connection (MongoDB or PostgreSQL)
# Example MongoDB: mongodb://localhost:27017/bodaboda_express
# Example PostgreSQL: postgres://postgres:password@localhost:5432/bodaboda_express
DATABASE_URL=mongodb://localhost:27017/bodaboda_express

# Payment Gateways (Vodacom M-Pesa, Airtel Money, Tigo Pesa)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=000000
MPESA_PASSKEY=your_passkey

# Google Maps API Key (Optional for geocoding / route optimization on backend)
GOOGLE_MAPS_API_KEY=your_google_maps_key
